_BASE_: "Base-RCNN-FPN.yaml"
MODEL:
  WEIGHTS: "X-152-32x8d-IN5k.pkl"
  MASK_ON: False
  PIXEL_STD: [57.375, 57.120, 58.395]
  RESNETS:
    STRIDE_IN_1X1: False  
    NUM_GROUPS: 32
    WIDTH_PER_GROUP: 8
    DEPTH: 152
  ROI_HEADS:
    NUM_CLASSES: 1
SOLVER:
  STEPS: (88000, 99000)
  MAX_ITER: 100000
  IMS_PER_BATCH: 4
  BASE_LR: 0.001
  CHECKPOINT_PERIOD: 10000
TEST:
   EVAL_PERIOD: 1000
DATASETS:
  TRAIN: ("my_train",)
  TEST: ("my_test",)
DATALOADER:
  NUM_WORKERS: 1OUTPUT_DIR: "output/train_may_24_2023"
